#!/bin/sh
[ "$1" = "-T" ] || exit 0
cat <<'CONF'
# configuration file /etc/nginx/nginx.conf:
user www-data;
events { worker_connections 1024; }
http {
    upstream api_backend { server 127.0.0.1:8080; server 127.0.0.1:8081; }
    include /etc/nginx/conf.d/*.conf;
    server { listen 80 default_server; server_name _; return 444; }
}
stream {
    server { listen 3307; proxy_pass 10.0.0.5:3306; }
}

# configuration file /etc/nginx/conf.d/shop.conf:
server {
    listen 443 ssl http2;
    server_name shop.example.com www.shop.example.com;
    root /var/www/shop;  # 商城
    ssl_certificate /etc/letsencrypt/live/shop/fullchain.pem;
    location / { try_files $uri /index.html; }
    location /api/ { proxy_pass http://api_backend; }
}
server {
    listen 80;
    server_name shop.example.com;
    return 301 https://$host$request_uri;
}

# configuration file /etc/nginx/conf.d/blog.conf:
server {
    listen 80;
    server_name "blog.example.com";
    location / { proxy_pass http://127.0.0.1:2368; }
}
CONF
